# Configurações do banco de dados PostgreSQL
POSTGRES_DB=classpath
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha

# String de conexão usada pelo Spring Boot
DATABASE_URL=jdbc:postgresql://localhost:5432/classpath
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=troque_esta_senha

# Exibe no console o SQL gerado pelo Hibernate (true/false)
SHOW_SQL=true

# Origens permitidas para requisições CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000