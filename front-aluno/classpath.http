### ClassPath — requisições da API
#
# Abra este arquivo no WebStorm e clique no ▶ verde à esquerda de cada
# requisição. O IDE mostra status, tempo e corpo da resposta.
#
# Rode na ordem de cima para baixo: os blocos guardam os IDs criados em
# variáveis, então o horário e o aviso já saem ligados à disciplina.
#
# Para trocar de ambiente, use o seletor no canto superior direito
# (as opções vêm de http-client.env.json).

@baseUrl = {{host}}
@contentType = application/json

### Verificar se a API está no ar
GET {{baseUrl}}/disciplinas
Accept: application/json

> {%
    client.test("respondeu 200", () => {
        client.assert(response.status === 200, "Status foi " + response.status);
    });
    client.test("devolveu uma lista", () => {
        client.assert(Array.isArray(response.body), "O corpo não é um array");
    });
%}

### Criar disciplina
POST {{baseUrl}}/disciplinas
Content-Type: {{contentType}}

{
  "nome": "Cálculo I",
  "professor": "Ana Ribeiro"
}

> {%
    client.test("criou", () => {
        client.assert(response.status === 200 || response.status === 201,
            "Status foi " + response.status);
    });
    client.global.set("disciplinaId", response.body.id);
%}

### Buscar a disciplina criada
GET {{baseUrl}}/disciplinas/{{disciplinaId}}
Accept: application/json

### Atualizar a disciplina
PUT {{baseUrl}}/disciplinas/{{disciplinaId}}
Content-Type: {{contentType}}

{
  "nome": "Cálculo I - Turma A",
  "professor": "Ana Ribeiro"
}

### Criar horário na disciplina
POST {{baseUrl}}/horarios
Content-Type: {{contentType}}

{
  "disciplinaId": {{disciplinaId}},
  "diaSemana": "Segunda-feira",
  "horarioInicio": "08:00",
  "horarioFim": "10:00",
  "sala": "Laboratório 02"
}

> {%
    client.global.set("horarioId", response.body.id);
%}

### Criar horário inválido — fim antes do início
# Esperado: a API recusa. Se ela aceitar, a validação está só no front.
POST {{baseUrl}}/horarios
Content-Type: {{contentType}}

{
  "disciplinaId": {{disciplinaId}},
  "diaSemana": "Terça-feira",
  "horarioInicio": "10:00",
  "horarioFim": "08:00",
  "sala": "Sala 1"
}

> {%
    client.test("recusou o horário invertido", () => {
        client.assert(response.status >= 400,
            "A API aceitou fim antes do início (status " + response.status + ")");
    });
%}

### Listar horários sem filtro
GET {{baseUrl}}/horarios
Accept: application/json

### Listar horários filtrando por disciplina
GET {{baseUrl}}/horarios?disciplinaId={{disciplinaId}}
Accept: application/json

> {%
    client.test("só veio a disciplina pedida", () => {
        const fora = response.body.filter((h) => h.disciplinaId !== client.global.get("disciplinaId"));
        client.assert(fora.length === 0, "Vieram " + fora.length + " horários de outra disciplina");
    });
%}

### Criar aviso na disciplina
POST {{baseUrl}}/avisos
Content-Type: {{contentType}}

{
  "disciplinaId": {{disciplinaId}},
  "titulo": "Prova na sexta",
  "descricao": "Conteúdo das aulas 1 a 6.\nTrazer calculadora.",
  "dataPublicacao": "2026-03-01"
}

> {%
    client.global.set("avisoId", response.body.id);
%}

### Listar avisos filtrando por disciplina
GET {{baseUrl}}/avisos?disciplinaId={{disciplinaId}}
Accept: application/json

### Excluir disciplina com dependências — esperado HTTP 409
DELETE {{baseUrl}}/disciplinas/{{disciplinaId}}

> {%
    client.test("bloqueou a exclusão em cascata", () => {
        client.assert(response.status === 409,
            "Esperava 409, veio " + response.status);
    });
%}

### Limpar: aviso
DELETE {{baseUrl}}/avisos/{{avisoId}}

### Limpar: horário
DELETE {{baseUrl}}/horarios/{{horarioId}}

### Limpar: disciplina — agora deve funcionar
DELETE {{baseUrl}}/disciplinas/{{disciplinaId}}

> {%
    client.test("excluiu sem dependências", () => {
        client.assert(response.status < 400, "Status foi " + response.status);
    });
%}

### Buscar disciplina que não existe — esperado 404
GET {{baseUrl}}/disciplinas/999999
Accept: application/json

### Enviar corpo inválido — esperado 400
POST {{baseUrl}}/disciplinas
Content-Type: {{contentType}}

{
  "nome": "",
  "professor": ""
}
