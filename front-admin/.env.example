# Para o BFF em Docker Desktop usando APIs executadas no host.
# Ao rodar o Python diretamente no host, substitua host.docker.internal por localhost.
URL_SPRING_BOOT=http://host.docker.internal:8080/api
URL_FASTAPI=http://host.docker.internal:8000/api
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ACADEMIC_ADMIN_TOKEN=
MATERIALS_ADMIN_TOKEN=
MATERIALS_MAX_UPLOAD_BYTES=20971520
# false apenas no desenvolvimento local por HTTP
SESSION_COOKIE_SECURE=false
